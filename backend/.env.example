# Tandelo 後端環境變數（複製成 .env 後填；全部都是佔位，不要放真實金鑰進 git）
APP_ENV=dev
# 預設 SQLite；Docker 裡是 sqlite:////data/tandelo.db；換 Postgres 例：postgresql+psycopg://tandelo:tandelo@postgres:5432/tandelo
DATABASE_URL=sqlite:///./data/tandelo.db
# CORS 白名單（逗號分隔）。Pages 版前端要加 https://edwardtseng33.github.io
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# 讀招募表單用的管理權杖；空字串＝關閉管理端點。請自己產生一段亂數，例如：openssl rand -hex 24
ADMIN_TOKEN=
# 每個來源 IP 每分鐘的請求上限
RATE_LIMIT_PER_MINUTE=120
# 小陪回覆提供者：rules（規則引擎）或 anthropic（接模型；要先 pip install 'tandelo-backend[llm]'）
COACH_PROVIDER=rules
# 接模型才需要；只放在環境變數，絕不寫進程式或 git。沒設就自動退回 rules
ANTHROPIC_API_KEY=
# 接模型用的模型 id（沒設就用程式預設）
COACH_MODEL=claude-sonnet-5-5
TIMEZONE=Asia/Taipei
LIGHTS_OUT_START=22:30
LIGHTS_OUT_END=06:00
# 啟動時資料庫是空的就灌種子資料（Docker 預設開）
SEED_ON_STARTUP=false
