# docker-compose 用的環境變數（複製成 .env；全部是佔位，.env 不進 git）
APP_ENV=dev
# 預設 SQLite 存在 ./data；要用 Postgres：docker compose --profile postgres up -d 並改成下面這行
DATABASE_URL=sqlite:////data/tandelo.db
# DATABASE_URL=postgresql+psycopg://tandelo:change-me-locally@postgres:5432/tandelo   （後端映像要另裝 psycopg，見 docs/ARCHITECTURE.md）
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# 讀招募表單的管理權杖；自己產生：openssl rand -hex 24
ADMIN_TOKEN=
RATE_LIMIT_PER_MINUTE=120
COACH_PROVIDER=rules
SEED_ON_STARTUP=true
# 題目變體 answer_token 的簽章金鑰；空＝每次啟動隨機產生
VARIANT_SECRET=
# Postgres profile 才用得到
POSTGRES_DB=tandelo
POSTGRES_USER=tandelo
POSTGRES_PASSWORD=change-me-locally
